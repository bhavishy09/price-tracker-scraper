{
  "name": "ine-price-tracker-backend",
  "version": "1.0.0",
  "description": "Express backend + Playwright scraper for the INE Product Price Tracker assignment",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape": "node src/scraper/run-scrape.js",
    "scrape:headed": "node src/scraper/run-scrape.js --headed",
    "scrape:test": "node src/scraper/run-scrape.js 921 --headed"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "playwright": "^1.47.0",
    "@supabase/supabase-js": "^2.45.0",
    "dotenv": "^16.4.5",
    "morgan": "^1.10.0"
  }
}
