# --- Backend environment variables ---
# Copy this file to .env and fill in real values. NEVER commit .env.

# Port the Express server listens on. Render injects PORT automatically.
PORT=3001
NODE_ENV=development

# --- Supabase ---
# Project URL, e.g. https://abcd.supabase.co
SUPABASE_URL=
# Service role key (NOT the anon key) — the backend is a trusted server.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mock store ---
# Base URL of INE's hosted mock store. Rarely needs changing.
INE_STORE_BASE_URL=https://demo.inelabteamdev.com
INE_FETCH_TIMEOUT_MS=15000

# --- Scraper ---
# Set to "false" to run the scraper in HEADED mode for the demo recording.
# Default (anything else / unset) = headless.
HEADLESS=true
# How many tracked products to scrape in parallel. Keep at 1 for the mock
# store (it is intentionally flaky under concurrent load).
SCRAPER_CONCURRENCY=1
# Stale-lock safety net, in minutes. If a previous run crashed without
# releasing the lock, the next run will forcibly take it after this long.
SCRAPE_STALE_AFTER_MINUTES=15

# --- Cron trigger security ---
# The secret that cron-job.org must send in the X-Cron-Secret header
# (or ?secret= query param) to trigger a scrape. Generate a long random
# string, e.g.:  openssl rand -hex 32
CRON_SECRET=

# --- SendGrid Alerts (Optional) ---
# API key starting with SG. for email alerts on price drops & back in stock
SENDGRID_API_KEY=
# Target email address to receive notifications
ALERT_EMAIL=
# Verified sender email address on SendGrid
SENDGRID_FROM_EMAIL=alerts@ine-tracker.local

# --- CORS ---
# Comma-separated list of allowed frontend origins, or '*' for any.
# For the assignment: '*' is fine (no auth). In production with auth,
# set this to your exact Vercel URL.
CORS_ORIGINS=*
