# --- Frontend environment variables ---
# Copy this file to .env and fill in real values. NEVER commit .env.

# The backend URL the frontend should talk to.
# - In local dev: leave BLANK — Vite proxies /api/* to localhost:3001 (see vite.config.js).
# - In production on Vercel: set this to your Render backend URL, e.g.
#   VITE_BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=
